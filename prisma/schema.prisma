generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USERSHOP
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum TrendPeriod {
  WEEK
  MONTH
  YEAR
}

enum TrendDirection {
  RISING
  FALLING
  STABLE
}

enum ErpSyncTrigger {
  MANUAL
  SCRIPT
  AUTOMATIC
}

enum ErpSyncStatus {
  RUNNING
  SUCCESS
  ERROR
  CANCELED
}

enum QuoteStatus {
  PENDING
  ERP_REGISTERED
  ERROR
}

enum ComplaintType {
  RECLAMO
  QUEJA
}

enum HeroBannerSlot {
  HERO
  CATEGORY
  PROMO
  LANDING
  WIDGET
}

enum HeroBannerLayout {
  HERO_DESKTOP_FULL
  HERO_MOBILE
  BANNER_SQUARE
  PROMO_STRIP
}

enum HeroBannerTextAlign {
  LEFT
  CENTER
  RIGHT
}

enum HeroBannerContentPosition {
  LEFT
  CENTER
  RIGHT
}

enum ComplaintStatus {
  NEW
  IN_REVIEW
  RESPONDED
  CLOSED
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  name                  String
  phone                 String?  @db.VarChar(32)
  passwordHash          String
  role                  UserRole @default(ADMIN)
  requirePasswordChange Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  quotes                Quote[]  @relation("UserQuotes")
}

model Product {
  id              String         @id @default(cuid())
  code            String         @unique @db.VarChar(64)
  slug            String         @unique @db.VarChar(140)
  name            String         @db.VarChar(180)
  description     String?        @db.Text
  technicalSpecs  String?        @db.Text
  brand           String?        @db.VarChar(120)
  category        String?        @db.VarChar(120)
  categoryId      String?
  categoryRef     Category?      @relation("CategoryToProduct", fields: [categoryId], references: [id], onDelete: SetNull)
  imageUrl        String?        @db.Text
  sourceImageUrl  String?        @db.Text
  localImageUrl   String?        @db.Text
  sourceImageFingerprint String?        @db.VarChar(64)
  sourceImageContentHash String?        @db.VarChar(64)
  unitLabel       String         @default("unidad") @db.VarChar(40)
  unitPrice       Decimal        @db.Decimal(10, 2)
  wholesalePrice  Decimal?       @db.Decimal(10, 2)
  wholesaleMinQty Int            @default(3)
  boxPrice        Decimal?       @db.Decimal(10, 2)
  unitsPerBox     Int?
  stockUnits      Int            @default(0)
  isVisible       Boolean        @default(true)
  isFeatured      Boolean        @default(false)
  externalSource  String?        @db.VarChar(80)
  externalId      String?        @db.VarChar(120)
  externalCode    String?        @db.VarChar(120)
  syncEnabled     Boolean        @default(false)
  lastSyncedAt    DateTime?
  erpUpdatedAt    DateTime?
  syncHash        String?        @db.VarChar(64)
  syncQuickHash   String?        @db.VarChar(64)
  syncStockHash   String?        @db.VarChar(64)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  media           ProductMedia[]
  quoteItems      QuoteItem[]    @relation("ProductQuoteItems")
  digitalProfile  DigitalProductProfile?
  specifications  ProductSpecification[]
  variants        ProductVariant[]
  videos          ProductVideo[]
  documents       ProductDocument[]
  qr              ProductQr?
  qrAnalyticsLogs QrAnalyticsLog[]

  @@index([name])
  @@index([code])
  @@index([category, isVisible])
  @@index([brand, isVisible])
  @@index([isVisible, updatedAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@index([stockUnits])
  @@index([categoryId])
  @@index([externalSource, externalId])
  @@index([externalSource, externalCode])
  @@index([syncEnabled, lastSyncedAt])
  @@index([syncEnabled])
  @@index([lastSyncedAt])
  @@index([sourceImageUrl])
  @@index([localImageUrl])
  @@index([externalId])
  @@index([syncHash])
  @@index([syncQuickHash])
  @@index([syncStockHash])
}

model ProductMedia {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      ProductMediaType
  url       String           @db.Text
  altText   String?          @db.VarChar(180)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([productId, sortOrder])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(120)
  slug      String    @unique @db.VarChar(140)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[] @relation("CategoryToProduct")

  @@index([name])
}

model StoreSettings {
  id                  Int      @id @default(1)
  businessName        String   @default("Importaciones Super")
  heroTitle           String   @default("Catálogo mayorista con pedido directo por WhatsApp")
  heroDescription     String   @default("Explora el stock disponible, arma tu pedido y envíalo en segundos sin llamadas ni pasos innecesarios.")
  heroSlides          Json?
  heroAutoplaySeconds Int      @default(5)
  whatsappNumber      String   @default("51999999999")
  orderIntro          String   @default("Hola, quiero cotizar estos productos:")
  orderFooter         String   @default("Quedo atento a la confirmación de stock y total final.")
  currencySymbol      String   @default("S/")
  highlightMessage    String   @default("Precios por unidad y mayorista sincronizados con el ERP.")
  supportHours        String   @default("Lun a sáb 8:00 am - 7:00 pm")
  primaryColor        String   @default("#2320DA")
  accentColor         String   @default("#2320DA")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model HeroBanner {
  id               String                   @id @default(cuid())
  slot             HeroBannerSlot           @default(HERO)
  layout           HeroBannerLayout         @default(HERO_DESKTOP_FULL)
  title            String?                  @db.VarChar(180)
  subtitle         String?                  @db.VarChar(240)
  description      String?                  @db.Text
  ctaLabel         String?                  @db.VarChar(80)
  ctaHref          String?                  @db.Text
  desktopImageUrl  String                   @db.Text
  mobileImageUrl   String?                  @db.Text
  altText          String?                  @db.VarChar(180)
  overlayColor     String                   @default("#000000") @db.VarChar(16)
  overlayOpacity   Float                    @default(0.36)
  textAlign        HeroBannerTextAlign      @default(LEFT)
  contentPosition  HeroBannerContentPosition @default(LEFT)
  priority         Int                      @default(0)
  sortOrder        Int                      @default(0)
  isActive         Boolean                  @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  campaignName     String?                  @db.VarChar(120)
  analyticsKey     String?                  @db.VarChar(120)
  impressionCount  Int                      @default(0)
  clickCount       Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([slot, isActive, sortOrder])
  @@index([slot, priority(sort: Desc), sortOrder])
  @@index([slot, startsAt, endsAt])
  @@index([campaignName])
}

model Quote {
  id                     String      @id @default(cuid())
  userId                 String?
  user                   User?       @relation("UserQuotes", fields: [userId], references: [id], onDelete: SetNull)
  status                 QuoteStatus @default(PENDING)
  quoteNumber            String?     @db.VarChar(80)
  erpExternalId          String?     @db.VarChar(120)
  erpCustomerId          Int?
  erpCustomerMode        String?     @db.VarChar(40)
  customerName           String      @db.VarChar(180)
  customerPhone          String      @db.VarChar(32)
  customerEmail          String?     @db.VarChar(180)
  customerDocumentType   String?     @db.VarChar(20)
  customerDocumentNumber String?     @db.VarChar(40)
  customerAddress        String?     @db.Text
  currencySymbol         String      @default("S/") @db.VarChar(8)
  total                  Decimal     @db.Decimal(12, 2)
  note                   String?     @db.Text
  errorMessage           String?     @db.Text
  statusSteps            Json?
  pdfNotification        Json?
  whatsappHref           String?     @db.Text
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  items                  QuoteItem[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([quoteNumber])
  @@index([customerPhone])
  @@index([customerEmail])
}

model QuoteItem {
  id         String   @id @default(cuid())
  quoteId    String
  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation("ProductQuoteItems", fields: [productId], references: [id], onDelete: SetNull)
  code       String   @db.VarChar(64)
  externalId String?  @db.VarChar(120)
  name       String   @db.VarChar(180)
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  total      Decimal  @db.Decimal(12, 2)
  tierLabel  String   @db.VarChar(40)
  createdAt  DateTime @default(now())

  @@index([quoteId])
  @@index([productId])
  @@index([code])
}

model Complaint {
  id                      String          @id @default(cuid())
  sheetNumber             String          @unique @db.VarChar(32) // Formato: LR-YYYY-XXXXXX
  serialNumber            Int             // Número correlativo dentro del año
  year                    Int             // Año del reclamo (ej: 2026)
  
  // Datos del Consumidor
  documentType            String          @db.VarChar(16) // DNI, CE, RUC, PASAPORTE
  documentNumber          String          @db.VarChar(32)
  names                   String          @db.VarChar(100)
  lastNames               String          @db.VarChar(100)
  email                   String          @db.VarChar(150)
  phone                   String          @db.VarChar(32)
  address                 String          @db.VarChar(255)
  department              String          @db.VarChar(64)
  province                String          @db.VarChar(64)
  district                String          @db.VarChar(64)
  
  // Representante (Si es menor de edad)
  isMinor                 Boolean         @default(false)
  repNames                String?         @db.VarChar(200)
  repDocumentType         String?         @db.VarChar(16)
  repDocumentNumber       String?         @db.VarChar(32)
  
  // Datos de la Compra / Bien Contratado
  isPurchaseRelated       Boolean         @default(false)
  orderNumber             String?         @db.VarChar(64)
  invoiceNumber           String?         @db.VarChar(64)
  purchaseDate            DateTime?
  productName             String?         @db.VarChar(200)
  productBrand            String?         @db.VarChar(100)
  productModel            String?         @db.VarChar(100)
  productSku              String?         @db.VarChar(100)
  productSerial           String?         @db.VarChar(100)
  purchaseAmount          Decimal?        @db.Decimal(10, 2)
  purchaseChannel         String?         @db.VarChar(64) // Web, Físico, WhatsApp, etc.
  paymentMethod           String?         @db.VarChar(64) // Transferencia, Efectivo, Tarjeta
  
  // Detalles del Reclamo/Queja
  type                    ComplaintType   @default(RECLAMO)
  reason                  String          @db.VarChar(100)
  subReason               String?         @db.VarChar(150)
  facts                   String          @db.Text
  request                 String          @db.Text
  
  // Gestión Administrativa
  status                  ComplaintStatus @default(NEW)
  adminReply              String?         @db.Text
  repliedAt               DateTime?
  repliedByEmail          String?         @db.VarChar(150)
  assignedToName          String?         @db.VarChar(100)
  assignedToEmail         String?         @db.VarChar(150)
  expiryDate              DateTime        // Fecha límite de 15 días hábiles
  internalNotes           ComplaintInternalNote[]
  
  // Adjuntos
  attachments             Json            @default("[]") // Listado de URLs de archivos subidos
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@index([phone])
}

model ComplaintInternalNote {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String
  content     String    @db.Text
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt(sort: Desc)])
}

model ServiceFeedback {
  id              String                        @id @default(cuid())
  rating          String                        @db.VarChar(20)
  attendedBy      String?                       @db.VarChar(180)
  improvement     String?                       @db.Text
  hadProblem      Boolean
  problemDetail   String?                       @db.Text
  wouldRecommend  Boolean
  customerContact String?                       @db.VarChar(180)
  status          ComplaintStatus               @default(NEW)
  assignedToName  String?                       @db.VarChar(180)
  assignedToEmail String?                       @db.VarChar(180)
  createdAt       DateTime                      @default(now())
  internalNotes   ServiceFeedbackInternalNote[]

  @@index([createdAt(sort: Desc)])
  @@index([rating])
  @@index([hadProblem])
}

model ServiceFeedbackInternalNote {
  id                String          @id @default(cuid())
  serviceFeedbackId String
  serviceFeedback   ServiceFeedback @relation(fields: [serviceFeedbackId], references: [id], onDelete: Cascade)
  authorName        String          @db.VarChar(180)
  authorEmail       String          @db.VarChar(180)
  content           String          @db.Text
  createdAt         DateTime        @default(now())

  @@index([serviceFeedbackId, createdAt(sort: Desc)])
}

model ShopAssistantLog {
  id              String   @id @default(cuid())
  sessionId       String?
  userMessage     String
  baseReply       String?
  finalReply      String?
  intent          String?
  usedOllama      Boolean  @default(false)
  ollamaModel     String?
  ollamaLatencyMs Int?
  productsCount   Int      @default(0)
  productIds      String?
  error           String?
  createdAt       DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model SalesTrendSnapshot {
  id          String      @id @default(cuid())
  period      TrendPeriod
  periodLabel String      @db.VarChar(50)
  periodStart DateTime
  periodEnd   DateTime
  revenue     Decimal     @db.Decimal(12, 2)
  orders      Int
  unitsSold   Int
  forecast    Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([period, periodStart(sort: Desc)])
}

model ProductTrendSnapshot {
  id            String         @id @default(cuid())
  period        TrendPeriod
  periodLabel   String         @db.VarChar(50)
  productCode   String         @db.VarChar(64)
  productName   String         @db.VarChar(180)
  unitsSold     Int
  deltaPercent  Decimal        @db.Decimal(8, 2)
  momentumScore Decimal        @db.Decimal(8, 2)
  direction     TrendDirection
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([period, direction])
  @@index([period, momentumScore(sort: Desc)])
}

model ErpSyncLog {
  id                String         @id @default(cuid())
  source            String         @db.VarChar(80)
  trigger           ErpSyncTrigger @default(SCRIPT)
  syncMode          String         @default("FULL") @db.VarChar(20)
  status            ErpSyncStatus  @default(RUNNING)
  fetchedCount      Int            @default(0)
  progressTotalCount Int            @default(0)
  processedCount    Int            @default(0)
  createdCount      Int            @default(0)
  updatedCount      Int            @default(0)
  skippedCount      Int            @default(0)
  errorCount        Int            @default(0)
  failedPage        Int?
  failedPageMessage String?        @db.Text
  skippedPreview    Json?
  errorMessage      String?        @db.Text
  cancelRequestedAt DateTime?
  initiatedByName   String?        @db.VarChar(120)
  initiatedByEmail  String?        @db.VarChar(180)
  canceledByName    String?        @db.VarChar(120)
  canceledByEmail   String?        @db.VarChar(180)
  startedAt         DateTime       @default(now())
  finishedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model SyncEventQueue {
  id           String    @id @default(cuid())
  sku          String    @db.VarChar(64)
  eventType    String    @db.VarChar(64) // PRODUCT_CREATED, PRODUCT_STOCK_UPDATED, etc.
  payload      Json
  status       String    @default("PENDING") @db.VarChar(20) // PENDING, PROCESSING, COMPLETED, FAILED
  attempts     Int       @default(0)
  errorMessage String?   @db.Text
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@index([status, createdAt])
  @@index([sku])
}

model DigitalProductProfile {
  id               String          @id @default(cuid())
  productId        String          @unique
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  descriptionShort String?         @db.Text
  descriptionFull  String?         @db.Text
  status           String          @default("BORRADOR") @db.VarChar(20) // BORRADOR, PUBLICADA
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([productId])
  @@index([status])
}

model ProductSpecification {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(120)
  value      String   @db.VarChar(255)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(120)
  hexColor    String?  @db.VarChar(16)
  imageUrl    String?  @db.Text
  sku         String?  @db.VarChar(64)
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductVideo {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title        String   @db.VarChar(180)
  url          String   @db.Text
  provider     String   @db.VarChar(40) // YOUTUBE, YOUTUBE_SHORTS
  videoId      String   @db.VarChar(80)
  thumbnailUrl String?  @db.Text
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductDocument {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(180)
  url       String   @db.Text
  type      String   @db.VarChar(40) // PDF, WARRANTY, MANUAL, GUIDE
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductQr {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  destUrl   String   @db.Text
  imageUrl  String?  @db.Text // Base64 del código QR generado localmente
  size      Int      @default(400)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model QrAnalyticsLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  eventType String   @db.VarChar(64) // QR_OPEN, VIDEO_PLAY, ADD_TO_CART_FROM_QR, DOCUMENT_OPEN, WHATSAPP_FROM_QR
  sessionId String?  @db.VarChar(128)
  timestamp DateTime @default(now())

  @@index([productId, eventType])
  @@index([timestamp])
}
