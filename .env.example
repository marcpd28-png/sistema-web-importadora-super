# Operación del VPS: utiliza una clave SSH con acceso limitado; nunca guardes
# contraseñas ni claves privadas en el repositorio.
VPS_HOST=""
VPS_USER=""
VPS_SSH_PRIVATE_KEY_PATH=""
VPS_PORT="22"
VPS_PROJECT_PATH="/home/IMPORTADORA"
