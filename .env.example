ERP_SYNC_FULL_COMPLETE="false"
ERP_SYNC_WINDOW_PAGES="10"
ERP_SYNC_THROTTLE_COOLDOWN_MINUTES="10"
ERP_IMAGE_CHECK_BATCH_SIZE="100"
ERP_IMAGE_CHECK_CONCURRENCY="10"

