# Defaults: all rollout flags disabled; set only on the Rocky simulator instance initially.
ROCKY_SIMULATOR_ENABLED=false
ROCKY_LLM_ENABLED=false
ROCKY_MODEL=qwen3.5:9b
# Embedding model must produce 1024 dimensions; changing it requires an explicit reindex.
ROCKY_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Additional gate; never enables AUTO without the existing switches and conversation permissions.
ROCKY_AUTONOMY_LEVEL=2
ROCKY_AUTO_RESPONSE_THRESHOLD=0.85
ROCKY_ASSISTED_THRESHOLD=0.60
ROCKY_HANDOFF_THRESHOLD=0.30
ROCKY_TOOL_TIMEOUT_MS=15000
# OLLAMA_MODEL belongs to the legacy provider in src/lib/ollama.ts; it is not read by Roky.
ROCKY_OLLAMA_URL=http://127.0.0.1:11434
ROCKY_RAG_VECTOR_ENABLED=false
ROCKY_AUTO_ENABLED=false
ROCKY_COPILOT_ENABLED=false
# Optional dedicated read-only n8n adapter. Never point to an existing outbound workflow.
# ROCKY_N8N_CATALOG_PREVIEW_PATH=/webhook/rocky-catalog-preview
# Reuses N8N_INTERNAL_API_KEY, DATABASE_URL and admin sessions; do not add secrets to this file.
