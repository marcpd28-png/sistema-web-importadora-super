      "parameters": {
        "jsCode": "const context = $('Prepare Media Context').first().json;\nlet content = context.content || '';\nlet visualHints = null;\nif (context.needsAudio) {\n  try {\n    const transcription = $('Transcribe Audio').first().json.transcription;\n    if (transcription?.status === 'READY' && typeof transcription.text === 'string') content = transcription.text;\n  } catch {}\n}\nif (context.needsVision) {\n  try {\n    const vision = $('Analyze Product Image').first().json;\n    if (vision?.analysis?.status === 'READY') visualHints = vision.visualHints ?? vision.analysis.hints ?? null;\n  } catch {}\n}\nconst latestMedia = context.latestMedia;\nlet messageType = context.messageType || 'TEXT';\nif (context.needsAudio) messageType = 'AUDIO';\nelse if (latestMedia?.messageType) messageType = String(latestMedia.messageType).toUpperCase();\nreturn [{\n  json: {\n    conversationId: context.conversationId,\n    triggerMessageId: context.triggerMessageId,\n    content,\n    messageType,\n    mediaUrl: latestMedia?.mediaUrl ?? context.mediaUrl ?? null,\n    visualHints\n  }\n}];"
