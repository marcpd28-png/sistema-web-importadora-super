    {
      "parameters": {
        "jsCode": "const router = $('Route Message V2').first().json;\nconst normalized = $('Normalize Router Input').first().json;\nconst messages = Array.isArray(router.outboundMessages) ? router.outboundMessages : [];\nlet finalText = typeof router.draftText === 'string' ? router.draftText.trim() : '';\ntry {\n  const drafted = $('Optional AI Draft').first().json;\n  if (typeof drafted.text === 'string' && drafted.text.trim()) finalText = drafted.text.trim();\n} catch {}\nif (!finalText) {\n  finalText = messages\n    .filter((message) => String(message.type || 'TEXT').toUpperCase() === 'TEXT')\n    .map((message) => typeof message.text === 'string' ? message.text.trim() : '')\n    .filter(Boolean)\n    .join('\\n');\n}\nfunction splitWhatsappText(value, maxLength = 4000) {\n  const chunks = [];\n  let remaining = String(value || '').trim();\n  while (remaining.length > maxLength) {\n    const candidate = remaining.slice(0, maxLength + 1);\n    const breakpoints = [candidate.lastIndexOf('\\n\\n'), candidate.lastIndexOf('\\n'), candidate.lastIndexOf(' ')];\n    const safeBreakpoint = breakpoints.find((index) => index >= Math.floor(maxLength * 0.6));\n    const cut = typeof safeBreakpoint === 'number' && safeBreakpoint > 0 ? safeBreakpoint : maxLength;\n    chunks.push(remaining.slice(0, cut).trim());\n    remaining = remaining.slice(cut).trimStart();\n  }\n  if (remaining) chunks.push(remaining);\n  return chunks;\n}\nif (!normalized.isSimulation) throw new Error('Simulator required');\nconst prepared = [];\nlet insertedText = false;\nfor (const message of messages) {\n  const type = String(message.type || 'TEXT').toUpperCase();\n  if (type === 'TEXT') {\n    if (!insertedText) {\n      for (const chunk of splitWhatsappText(finalText || message.text)) prepared.push({ type: 'TEXT', content: chunk, mediaUrl: null });\n      insertedText = true;\n    }\n    continue;\n  }\n  let content = '';\n  let mediaUrl = null;\n  if (type === 'IMAGE') {\n    content = message.caption || 'Imagen del producto';\n    mediaUrl = message.imageUrl || message.mediaUrl || null;\n  } else if (type === 'DOCUMENT') {\n    content = message.caption || message.filename || 'Documento';\n    mediaUrl = message.documentUrl || message.mediaUrl || null;\n  } else if (type === 'VIDEO') {\n    content = message.caption || 'Video del producto';\n    mediaUrl = message.videoUrl || message.mediaUrl || null;\n  } else {\n    throw new Error(`Unsupported outbound type: ${type}`);\n  }\n  if (!mediaUrl) throw new Error(`${type} outbound message is missing mediaUrl`);\n  prepared.push({ type, content: String(content).trim(), mediaUrl });\n}\nif (!insertedText) {\n  for (const chunk of splitWhatsappText(finalText)) prepared.push({ type: 'TEXT', content: chunk, mediaUrl: null });\n}\nif (!prepared.length) return [];\nreturn [{ json: {\n  conversationId: router.conversation.id,\n  requestId: `bc:${normalized.triggerMessageId}`,\n  triggerMessageId: normalized.triggerMessageId,\n  messages: prepared,\n  isSimulation: true\n} }];"
      },
