      "parameters": {
        "jsCode": "const normalized = $('Normalize Router Input').first().json;\nconst batchEnvelope = $('Batch Messages').first().json;\nconst batch = batchEnvelope.batch ?? {};\nconst media = Array.isArray(batch.media) ? batch.media : [];\nconst audioMedia = [...media].reverse().find((entry) => String(entry.messageType ?? '').toUpperCase() === 'AUDIO') ?? null;\nconst imageMedia = [...media].reverse().find((entry) => String(entry.messageType ?? '').toUpperCase() === 'IMAGE') ?? null;\nconst latestMedia = media.length ? media[media.length - 1] : null;\nconst salesState = $json.salesState ?? null;\nconst paymentEvidenceStage = salesState?.stage === 'AWAITING_PAYMENT_CONFIRMATION';\nconst isTrustedMetaMediaUrl = (value) => {\n  try {\n    const url = new URL(String(value || ''));\n    const host = url.hostname.toLowerCase();\n    return url.protocol === 'https:' && (host === 'graph.facebook.com' || host.endsWith('.facebook.com') || host === 'lookaside.fbsbx.com' || host.endsWith('.fbsbx.com'));\n  } catch {\n    return false;\n  }\n};\nreturn [{\n  json: {\n    ...normalized,\n    batch,\n    content: typeof batch.content === 'string' ? batch.content : normalized.content,\n    media,\n    latestMedia,\n    audioMedia,\n    imageMedia,\n    salesState,\n    needsAudio: Boolean(audioMedia),\n    needsVision: Boolean(imageMedia) && !paymentEvidenceStage,\n    audioRemoteTrusted: Boolean(audioMedia && isTrustedMetaMediaUrl(audioMedia.mediaUrl)),\n    imageRemoteTrusted: Boolean(imageMedia && isTrustedMetaMediaUrl(imageMedia.mediaUrl)),\n    paymentEvidenceStage\n  }\n}];"
      },
