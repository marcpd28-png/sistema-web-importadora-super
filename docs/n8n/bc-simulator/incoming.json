        "jsonBody": "={{ { conversationId: $('Preparar BC').first().json.conversationId, triggerMessageId: $json.batch.triggerMessageId, requestId: 'bc:' + $json.batch.triggerMessageId, messages: [{ type: 'TEXT', content: 'Recibí varios mensajes y la consulta es muy extensa. ¿Puedes resumirme qué productos o información necesitas para ayudarte mejor?' }] } }}",
