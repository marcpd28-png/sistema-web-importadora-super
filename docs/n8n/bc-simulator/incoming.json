      "position": [
        1760,
        100
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const batch = $input.first().json.batch;\nif (batch?.status !== 'READY') return [];\nconst saved = $('Preparar BC').first().json;\nreturn [{ json: { ...saved, content: batch.content, triggerMessageId: batch.latestMessageId, requestId: 'bc:' + batch.latestMessageId, messageIds: batch.messageIds } }];"
      }
    }
