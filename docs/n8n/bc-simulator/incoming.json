{
  "name": "BC - Simulador - Entrada",
  "nodes": [
    {
      "id": "1e3eccb3-10eb-4699-88ef-ff1a3bb1f41b",
      "name": "Entrada del simulador",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "bc-simulator",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "408224bf-adda-4810-8a1e-0adbfc400adc"
    },
    {
      "id": "bddf622d-cf25-4461-9c9c-f8db04d45003",
      "name": "Validar simulación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const body=$input.first().json.body;\nconst v=body?.entry?.[0]?.changes?.[0]?.value;\nconst m=v?.messages?.[0];\nif(v?.simulation?.dryRun!==true || v?.simulation?.source!=='admin-simulator' || !String(m?.from||'').startsWith('SIMULATOR:') || !String(m?.id||'').startsWith('SIM-CUSTOMER-') || typeof m?.text?.body!=='string' || !m.text.body.trim()) throw new Error('Solo se admiten mensajes del simulador de BC');\nreturn [{json:{channel:'WHATSAPP',externalContactId:m.from,externalMessageId:m.id,content:m.text.body,timestamp:new Date(Number(m.timestamp)*1000).toISOString(),name:v.contacts?.[0]?.profile?.name||'Cliente Simulador'}}];"
      }
    },
    {
      "id": "11bb1dec-c5b2-4376-9a7e-adb95865aced",
      "name": "Guardar mensaje de prueba",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://tiendavirtualsuper.com/api/internal/chat/incoming",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "5a8a98df-ad58-4fd9-8fd0-4b48c7beba48",
          "name": "Router V2 Internal API 20260913233533"
        }
      }
    },
    {
      "id": "d6c25eec-adce-4040-8058-5d535ccd0616",
      "name": "Confirmar recepción",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        660,
        -180
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, simulation: $json.simulation, duplicate: $json.duplicate, conversationId: $json.conversationId, messageId: $json.messageId } }}",
        "options": {}
      }
    },
    {
      "id": "5a57c855-7f2e-4ebe-a002-805034ea3f49",
      "name": "Preparar BC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        80
      ],
      "parameters": {
        "jsCode": "const saved=$input.first().json;\nif(saved.simulation!==true || saved.duplicate===true) return [];\nconst original=$('Validar simulación').first().json;\nreturn [{json:{...saved,content:original.content,triggerMessageId:saved.messageId,requestId:'catalog:'+saved.messageId}}];"
      }
    },
    {
      "id": "733f56f7-7532-48e8-a869-14e067839e01",
      "name": "¿Solicita catálogo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1980,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "02ed6da4-7b19-41ed-9ff2-97a59e960f98",
              "leftValue": "={{ (() => { const text = $json.content.normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase(); return /\\bcatalogos?\\b/.test(text) || (/\\bextensor(?:a|as|es|s)?\\b/.test(text) && /\\b(?:pantallas?|screens?|monitores?)\\b/.test(text)); })() }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "3b00dbe1-61ea-47df-99fd-386bfc7f0e28",
      "name": "Catálogo de prueba",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
