{
  "name": "BC - Simulador - Entrada",
  "nodes": [
    {
      "id": "1e3eccb3-10eb-4699-88ef-ff1a3bb1f41b",
      "name": "Entrada del simulador",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "bc-simulator",
        "responseMode": "responseNode",
        "options": {}
