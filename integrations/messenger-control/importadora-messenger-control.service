[Unit]
Description=Importadora Messenger manual control and durable schedules
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/importadora-messenger-control/service.py
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/importadora-messenger-control

[Install]
WantedBy=multi-user.target
